# Copiază în .env pentru dezvoltare locală.
# Pe cPanel, valorile se pun în „Setup Node.js App” → Environment variables (NU în cod).

APP_URL=http://localhost:3000

# MySQL / MariaDB (baza creată din cPanel → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# SMTP din cPanel (Email Accounts → Connect Devices). Gol = emailurile se afișează în consolă.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ConstructiiDevize <no-reply@constructiidevize.ro>"

# Stripe (mai târziu)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cheie pentru alertele zilnice (cron cPanel: curl "https://domeniu.ro/api/cron/alerte?key=...")
CRON_SECRET=

# Folder pentru fișierele încărcate (implicit ~/constructiidevize-uploads)
UPLOAD_DIR=

# Asistent AI (Claude). Cheia din console.anthropic.com. AI_MOCK=1 = răspunsuri simulate pentru teste.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MOCK=
